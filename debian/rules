#!/usr/bin/make -f
# debian/rules for bodyguard-of-bits — pybuild-based build using pyproject.toml.
#
# Verbose mode: uncomment to debug pybuild output.
#export DH_VERBOSE = 1

export PYBUILD_NAME = bodyguard-of-bits

# pybuild discovers tests/ automatically; pin to pytest explicitly.
export PYBUILD_TEST_PYTEST = 1

%:
	dh $@ --with python3 --buildsystem=pybuild

# Man pages and docs are installed automatically by dh_installman /
# dh_installdocs from the standard debian/bob-core.manpages and
# debian/bob-core.docs files — no override needed.
